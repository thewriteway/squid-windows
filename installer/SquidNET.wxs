<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="SquidNET">
 <Component Id="cmp4" Directory="bin" Guid="*">
        <File Id="fil4" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Service.deps.json" />
      </Component>

      <Component Id="cmp5" Directory="bin" Guid="*">
        <File Id="fil5" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Service.dll" />
      </Component>

      <Component Id="cmp6" Directory="bin" Guid="*">
        <File Id="fil6" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Service.dll.config" />
      </Component>

      <Component Id="cmp7" Directory="bin" Guid="*">
        <File Id="fil7" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Service.runtimeconfig.json" />
      </Component>

      <Component Id="cmp8" Directory="bin" Guid="*">
        <File Id="fil8" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Tray.deps.json" />
      </Component>

      <Component Id="cmp9" Directory="bin" Guid="*">
        <File Id="fil9" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Tray.dll" />
