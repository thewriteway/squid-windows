      </Component>

      <Component Id="cmp11" Directory="bin" Guid="*">
        <File Id="fil11" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Diladele.Squid.Tray.runtimeconfig.json" />
      </Component>

      <Component Id="cmp12" Directory="bin" Guid="*">
        <File Id="fil12" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\Microsoft.Windows.SDK.NET.dll" />
      </Component>

      <Component Id="cmp13" Directory="bin" Guid="*">
        <File Id="fil13" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\System.Collections.Immutable.dll" />
      </Component>

      <Component Id="cmp14" Directory="bin" Guid="*">
        <File Id="fil14" KeyPath="yes" Source="$(var.DiladeleDir)\diladele\System.Diagnostics.EventLog.dll" />
      </Component>

      <Component Id="cmp15" Directory="bin" Guid="*">
