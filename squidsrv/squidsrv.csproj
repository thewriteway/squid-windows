<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
  <OutputType>Exe</OutputType>
  <RootNamespace>Diladele.Squid.Service</RootNamespace>
  <AssemblyName>Diladele.Squid.Service</AssemblyName>
  <!-- Target Windows 10/11 64-bit -->
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <PlatformTarget>x64</PlatformTarget>
  <!-- Make it a single self-contained EXE -->
  <PublishSingleFile>true</PublishSingleFile>
  <SelfContained>false</SelfContained>
  <!-- Custom output folder -->
  <OutputPath>..\prepared\diladele\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\squid\diladele\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\prepared\diladele\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\squidtray\PredefinedPaths.cs">
      <Link>PredefinedPaths.cs</Link>
    </Compile>
    <Compile Update="SquidService.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="SquidService.Designer.cs">
      <DependentUpon>SquidService.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="SquidService.resx">
      <DependentUpon>SquidService.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
   <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
  </ItemGroup>
</Project>